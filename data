import pandas as pd
import numpy as np
import yfinance as yf
import matplotlib.pyplot as plt
from datetime import datetime, timedelta
import warnings
  
warnings.filterwarnings('ignore')
print ("Libraries imported.")


ASSET_UNIVERSE = {
    # Equities
    'ES': 'SPY',    # S&P 500
    'NQ': 'QQQ',    # Nasdaq 100
    'RTY': 'IWM',   # Russell 2000
    
    # Commodities
    'CL': 'USO',    # Crude Oil
    'GC': 'GLD',    # Gold
    'HG': 'CPER',   # Copper
    'NG': 'UNG',    # Natural Gas
    
    # FX
    'EUR': 'FXE',   # EUR/USD
    'GBP': 'FXB',   # GBP/USD
    'JPY': 'FXY',   # JPY/USD
    
    # Fixed Income
    'ZN': 'IEF',    # 10Y Treasury Bond
    'ZB': 'TLT',    # 20Y Treasury Bond
}

print(f"Asset universe defined: {len(ASSET_UNIVERSE)} assets")
print("\nAssets:")
for futures_name, etf_ticker in ASSET_UNIVERSE.items():
    print(f"  {futures_name:5} to {etf_ticker:5}")


# Here set time range for our data
END_DATE = datetime.now()
START_DATE = END_DATE - timedelta(days=365*10)  # ExL: 10 yrs ago

print(f"\n Downloading data from {START_DATE.date()} to {END_DATE.date()}")

# Download data for all assets
data = {}  # Dictionary to store dataframes

for futures_name, etf_ticker in ASSET_UNIVERSE.items():
    print(f"Downloading {futures_name} ({etf_ticker})...", end=" ")
    
    try:
        # Downloading from Yahoo Finance, may be able to find other data for future backtesting later
        df = yf.download(etf_ticker, start=START_DATE, end=END_DATE, progress=False)
        
        # Extract specifically closing price
        data[futures_name] = df['Close']
        
        print(f" {len(df)} days of data")
        
    except Exception as e:
        print(f" Error: {e}")
        data[futures_name] = None

print("\n Download complete!")


# Combine all assets into singular dataframe
# Each column = 1 asset, each row = 1 date
price_data = pd.DataFrame(data)

print(f"\n Combined data shape: {price_data.shape}")
print(f"   ({price_data.shape[0]} days × {price_data.shape[1]} assets)")

# Check for missing data
missing_pct = (price_data.isnull().sum() / len(price_data)) * 100
print("\n Missing data by asset:")
for asset, pct in missing_pct.items():
    print(f"   {asset:5}: {pct:.2f}%")


# Forward fill missing values (use previous day's price)
price_data_clean = price_data.fillna(method='ffill')

# Drop any remaining NaN at the start (before data begins)
price_data_clean = price_data_clean.dropna()

print(f"\n After cleaning: {price_data_clean.shape[0]} days")
print(f"   Removed {price_data.shape[0] - price_data_clean.shape[0]} incomplete days")

# Display first few rows
print("\n📋 First 5 rows:")
print(price_data_clean.head())
