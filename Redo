import yfinance as yf
import pandas as pd
import numpy as np
from datetime import datetime
import warnings
warnings.filterwarnings('ignore')

# Optional: plotting
import matplotlib.pyplot as plt

# Asset universe: futures mapped to ETFs
futures_to_etf = {
    'ES': 'SPY', 'NQ': 'QQQ', 'RTY': 'IWM', 'CL': 'USO',
    'GC': 'GLD', 'HG': 'CPER', 'NG': 'UNG', 'EUR': 'FXE',
    'GBP': 'FXB', 'JPY': 'FXY', 'ZN': 'IEF', 'ZB': 'TLT'
}

start = '2015-12-31'
end = '2025-12-28'

print("Libraries imported.")
print("Asset universe defined: 12 assets")
print("\nAssets:")
for future, etf in futures_to_etf.items():
    print(f"  {future:4s} to {etf}")

print(f"\nDownloading data from {start} to {end}")

# Download data
data = {}
for future, etf in futures_to_etf.items():
    print(f"Downloading {future} ({etf})...", end=" ")
    try:
        df = yf.download(etf, start=start, end=end,
                         progress=False, auto_adjust=True)

        if not df.empty:
            if isinstance(df.columns, pd.MultiIndex):
                close_col = df['Close'].iloc[:, 0] if 'Close' in df.columns.get_level_values(0) else df.iloc[:, -2]
            else:
                close_col = df['Close']

            prices = close_col.dropna()
            if len(prices) > 0:
                data[future] = prices
                print(f"{len(prices)} days")
                continue

        print("failed")
        data[future] = pd.Series(dtype=float)
    except Exception as e:
        print(f"error: {e}")
        data[future] = pd.Series(dtype=float)

print("\nDownload complete!")

# Create DataFrame
price_data = pd.DataFrame(data).ffill().dropna(how='all')

print(f"\nPrice data shape: {price_data.shape}")
if price_data.shape[1] > 0:
    print("\nFirst few rows:")
    print(price_data.head())

# ========================================
# ENHANCED TSMOM BACKTEST
# ========================================
if price_data.shape[1] > 0:

    # Calculate daily returns
    daily_returns = price_data.pct_change()

    # ========================================
    # MULTI-HORIZON MOMENTUM (3/6/12M, 1M skip)
    # ========================================
    skip = 21
    m3  = (price_data.shift(skip) / price_data.shift(63 + skip))  - 1
    m6  = (price_data.shift(skip) / price_data.shift(126 + skip)) - 1
    m12 = (price_data.shift(skip) / price_data.shift(252 + skip)) - 1

    def zscore(df):
        return (df - df.mean()) / df.std()

    z3, z6, z12 = zscore(m3), zscore(m6), zscore(m12)
    combined_momentum = (z3 + z6 + z12) / 3

    # Thresholded signal + weekly rebalancing
    lookback = 252
    warmup = lookback + skip
    threshold = 0.01                                                                                        ######################### Signal threshold

    raw_signal = pd.DataFrame(
        np.where(combined_momentum > threshold, 1,
                 np.where(combined_momentum < -threshold, -1, 0)),
        index=combined_momentum.index,
        columns=combined_momentum.columns
    )

    # Trade once per week (every 5th business day)
    rebalance_mask = (np.arange(len(raw_signal)) % 10 == 0)                                                 ######################### Rebalance frequency
    rebalance_mask_series = pd.Series(rebalance_mask, index=raw_signal.index)
    raw_signal = raw_signal.where(rebalance_mask_series, np.nan).ffill()

    # Remove warm-up
    signal = raw_signal.copy()
    signal.iloc[:warmup] = 0
    daily_returns = daily_returns.iloc[warmup:]
    signal = signal.iloc[warmup:]
    price_data_trim = price_data.iloc[warmup:]

    # Align combined_momentum
    cm_trim = combined_momentum.loc[signal.index]

    # ========================================
    # STRENGTH-BASED RISK-PARITY WEIGHTING
    # ========================================
    raw_weights = cm_trim.clip(-2, 2)

    vol_window = 60
    asset_vol = daily_returns.rolling(vol_window).std() * np.sqrt(252)
    asset_vol = asset_vol.replace(0, np.nan).ffill().fillna(0.01)
    inv_vol = 1 / asset_vol

    rp_weights = raw_weights * inv_vol
    rp_weights = rp_weights.div(rp_weights.abs().sum(axis=1), axis=0).fillna(0)

    # Final positions: align direction with signal
    positions = np.sign(signal) * rp_weights

    # Strategy returns (pre-cost, unlevered)
    strategy_returns = (positions.shift(1) * daily_returns).sum(axis=1)

    # ========================================
    # TRANSACTION COSTS
    # ========================================
    position_changes = positions.diff().abs().sum(axis=1)
    cost_per_turnover = 0.0002
    trading_costs = position_changes * cost_per_turnover
    net_portfolio = strategy_returns - trading_costs

    annual_turnover = position_changes.mean() * 252

    # ========================================
    # VOLATILITY TARGETING (10% TARGET)
    # ========================================
    vol_target = 0.10
    port_vol = strategy_returns.rolling(vol_window).std() * np.sqrt(252)
    vol_scalar = (vol_target / port_vol.replace(0, np.nan)).clip(0, 3).fillna(1)
    vol_target_returns = strategy_returns * vol_scalar.shift(1)

    # ========================================
    # OPTIONAL LEVERAGE (e.g. 2x) ON NET RETURNS
    # ========================================
    leverage = 2.0
    leveraged_returns = net_portfolio * leverage

    # ========================================
    # PERFORMANCE METRICS
    # ========================================
    def calc_metrics(returns):
        returns = returns.dropna()
        if len(returns) == 0:
            return 0.0, 0.0, 0.0
        cum = (1 + returns).cumprod()
        years = len(returns) / 252
        ann = cum.iloc[-1]**(1 / years) - 1 if years > 0 else 0
        vol = returns.std() * np.sqrt(252)
        sharpe = ann / vol if vol > 0 else 0.0
        running_max = cum.cummax()
        dd = (cum - running_max) / running_max
        max_dd = dd.min()
        return ann, sharpe, max_dd

    basic_ret, basic_sharpe, basic_dd = calc_metrics(strategy_returns)
    net_ret, net_sharpe, net_dd = calc_metrics(net_portfolio)
    vol_ret, vol_sharpe, vol_dd = calc_metrics(vol_target_returns)
    lev_ret, lev_sharpe, lev_dd = calc_metrics(leveraged_returns)

    # ========================================
    # CORE DIAGNOSTICS
    # ========================================
    print("\n" + "="*70)
    print("ENHANCED TSMOM RESULTS (3/6/12M, RP, WEEKLY, STRENGTH SIZING)")
    print("="*70)
    print(f"{'Strategy':<20} {'Ann Ret':>8} {'Sharpe':>8} {'Max DD':>8} {'Turnover':>10}")
    print("-"*70)
    print(f"{'Strength RP':<20} {basic_ret:>7.1%} {basic_sharpe:>8.2f} {basic_dd:>8.1%} {annual_turnover:>9.1f}x")
    print(f"{'+ Costs':<20} {net_ret:>7.1%} {net_sharpe:>8.2f} {net_dd:>8.1%} {annual_turnover:>9.1f}x")
    print(f"{'+ Vol Target (10%)':<20} {vol_ret:>7.1%} {vol_sharpe:>8.2f} {vol_dd:>8.1%} {'-':>10}")
    print(f"{'+ 2x Leverage':<20} {lev_ret:>7.1%} {lev_sharpe:>8.2f} {lev_dd:>8.1%} {'-':>10}")
    print("="*70)

    print("\nAdditional Statistics:")
    print(f"  Backtest period: {signal.index[0].strftime('%Y-%m-%d')} to {signal.index[-1].strftime('%Y-%m-%d')}")
    print(f"  Trading days: {len(signal)}")
    print(f"  Average |positions| per day: {positions.abs().sum(axis=1).mean():.2f}")
    print(f"  Annual turnover (notional): {annual_turnover:.1f}x")

    # ========================================
    # ASSET-LEVEL PERFORMANCE
    # ========================================
    print("\nAsset-Level Performance (Strength RP):")
    print(f"{'Asset':<8} {'Ann Ret':>9} {'Sharpe':>8} {'Win Rate':>10}")
    print("-"*50)

    asset_returns = positions.shift(1) * daily_returns
    for col in asset_returns.columns:
        r = asset_returns[col].dropna()
        if len(r) == 0:
            continue
        ann, sh, _ = calc_metrics(r)
        win = (r > 0).mean()
        print(f"{col:<8} {ann:>8.1%} {sh:>8.2f} {win:>9.1%}")

    # ========================================
    # PLOTTING
    # ========================================
    try:
        fig, axes = plt.subplots(2, 2, figsize=(15, 10))

        # 1. Cumulative returns
        cum_basic = (1 + strategy_returns).cumprod()
        cum_net = (1 + net_portfolio).cumprod()
        cum_vol = (1 + vol_target_returns).cumprod()
        cum_lev = (1 + leveraged_returns).cumprod()

        ax1 = axes[0, 0]
        ax1.plot(cum_basic.index, cum_basic, label='Strength RP', linewidth=2)
        ax1.plot(cum_net.index, cum_net, label='+ Costs', linewidth=2)
        ax1.plot(cum_vol.index, cum_vol, label='+ Vol Target', linewidth=2)
        ax1.plot(cum_lev.index, cum_lev, label='+ 2x Leverage', linewidth=2)
        ax1.set_title('Cumulative Returns', fontsize=12, fontweight='bold')
        ax1.set_ylabel('Cumulative Return')
        ax1.legend()
        ax1.grid(True, alpha=0.3)

        # 2. Drawdowns
        ax2 = axes[0, 1]
        dd_basic = (cum_basic / cum_basic.cummax() - 1) * 100
        dd_net = (cum_net / cum_net.cummax() - 1) * 100
        dd_vol = (cum_vol / cum_vol.cummax() - 1) * 100
        dd_lev = (cum_lev / cum_lev.cummax() - 1) * 100

        ax2.fill_between(dd_basic.index, dd_basic, 0, alpha=0.3, label='Strength RP')
        ax2.fill_between(dd_net.index, dd_net, 0, alpha=0.3, label='+ Costs')
        ax2.fill_between(dd_vol.index, dd_vol, 0, alpha=0.3, label='+ Vol Target')
        ax2.fill_between(dd_lev.index, dd_lev, 0, alpha=0.3, label='+ 2x Leverage')
        ax2.set_title('Drawdowns', fontsize=12, fontweight='bold')
        ax2.set_ylabel('Drawdown (%)')
        ax2.legend()
        ax2.grid(True, alpha=0.3)

        # 3. Rolling Sharpe (1-year) – pre- and post-cost
        ax3 = axes[1, 0]
        roll_window = 252
        roll_sharpe_basic = (strategy_returns.rolling(roll_window).mean() * 252) / (
            strategy_returns.rolling(roll_window).std() * np.sqrt(252)
        )
        roll_sharpe_net = (net_portfolio.rolling(roll_window).mean() * 252) / (
            net_portfolio.rolling(roll_window).std() * np.sqrt(252)
        )

        ax3.plot(roll_sharpe_basic.index, roll_sharpe_basic, label='Strength RP', linewidth=2)
        ax3.plot(roll_sharpe_net.index, roll_sharpe_net, label='+ Costs', linewidth=2)
        ax3.axhline(y=0, color='black', linestyle='--', alpha=0.5)
        ax3.set_title('Rolling 1-Year Sharpe Ratio', fontsize=12, fontweight='bold')
        ax3.set_ylabel('Sharpe Ratio')
        ax3.legend()
        ax3.grid(True, alpha=0.3)

        # 4. Annual returns (net vs 2x net)
        ax4 = axes[1, 1]
        annual_net = net_portfolio.resample('YE').apply(lambda x: (1 + x).prod() - 1) * 100
        annual_lev = leveraged_returns.resample('YE').apply(lambda x: (1 + x).prod() - 1) * 100

        years = [d.year for d in annual_net.index]
        x = np.arange(len(years))
        width = 0.35

        ax4.bar(x - width/2, annual_net, width, label='Net (1x)', alpha=0.8)
        ax4.bar(x + width/2, annual_lev, width, label='Net (2x)', alpha=0.8)
        ax4.set_title('Annual Returns', fontsize=12, fontweight='bold')
        ax4.set_ylabel('Return (%)')
        ax4.set_xticks(x)
        ax4.set_xticklabels(years, rotation=45)
        ax4.axhline(y=0, color='black', linestyle='--', alpha=0.5)
        ax4.legend()
        ax4.grid(True, alpha=0.3)

        plt.tight_layout()
        plt.savefig('tsmom_enhanced_results.png', dpi=300, bbox_inches='tight')
        print("\nChart saved to: tsmom_enhanced_results.png")
        plt.show()

    except Exception as e:
        print(f"\nPlotting error: {e}")
        print("Install matplotlib if needed: pip install matplotlib")

print("\n" + "="*70)
print("ANALYSIS COMPLETE")
print("="*70)
