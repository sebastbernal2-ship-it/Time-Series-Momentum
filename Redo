import yfinance as yf
import pandas as pd
import numpy as np
from datetime import datetime
import warnings
warnings.filterwarnings('ignore')
import matplotlib.pyplot as plt

# ========================================
# PRODUCTION TSMOM WITH VALIDATION
# ========================================
# This version includes:
# 1. Walk-forward validation (train/test split)
# 2. Cross-asset correlation independence check
# 3. Out-of-sample performance comparison
# 4. Stress period analysis

futures_to_etf = {
    'ES': 'SPY',    # Large-cap US
    'NQ': 'QQQ',    # Tech/Growth
    'RTY': 'IWM',   # Small-cap US
    'CL': 'USO',    # Oil
    'GC': 'GLD',    # Gold
    'ZB': 'TLT',    # Long bonds
    'EUR': 'FXE',   # Euro
    'JPY': 'FXY',   # Yen
}

start = '2015-12-31'
end = '2025-12-28'

print("="*70)
print("PRODUCTION TSMOM WITH WALK-FORWARD VALIDATION")
print("="*70)

# Download data
data = {}
for future, etf in futures_to_etf.items():
    print(f"Downloading {future} ({etf})...", end=" ")
    try:
        df = yf.download(etf, start=start, end=end, progress=False, auto_adjust=True)
        if not df.empty:
            if isinstance(df.columns, pd.MultiIndex):
                close_col = df['Close'].iloc[:, 0] if 'Close' in df.columns.get_level_values(0) else df.iloc[:, -2]
            else:
                close_col = df['Close']
            prices = close_col.dropna()
            if len(prices) > 0:
                data[future] = prices
                print(f"{len(prices)} days ✓")
                continue
        print("failed ✗")
    except Exception as e:
        print(f"error: {e} ✗")

price_data = pd.DataFrame(data).ffill().dropna(how='all')
print(f"\nPrice data shape: {price_data.shape}")

if price_data.shape[1] > 0:
    daily_returns = price_data.pct_change()

    # ========================================
    # 1. CORRELATION CHECK FOR INDEPENDENCE
    # ========================================
    print("\n" + "="*70)
    print("CROSS-ASSET CORRELATION (Full Period)")
    print("="*70)
    corr_full = daily_returns.corr()
    print(corr_full.round(2))
    
    # Check for redundancy
    print("\n" + "="*70)
    print("REDUNDANCY CHECK (>0.7 correlation)")
    print("="*70)
    high_corr = []
    for i in range(len(corr_full.columns)):
        for j in range(i+1, len(corr_full.columns)):
            if abs(corr_full.iloc[i, j]) > 0.7:
                high_corr.append((corr_full.columns[i], corr_full.columns[j], corr_full.iloc[i, j]))
    
    if high_corr:
        print("⚠️  HIGH CORRELATION PAIRS (>0.7):")
        for a, b, c in high_corr:
            print(f"  {a} ↔ {b}: {c:.3f}")
    else:
        print("✓ PASS: No redundant pairs. All assets independent (<0.7)")
    
    # Check negative correlations (crisis hedges)
    print("\n" + "="*70)
    print("HEDGE QUALITY CHECK (negative correlations)")
    print("="*70)
    es_corr = corr_full.loc['ES']
    print("ES (Large-cap US) correlations:")
    for asset in es_corr.index:
        if asset != 'ES':
            corr_val = es_corr[asset]
            quality = "✓ Good hedge" if corr_val < 0 else "↔ Neutral" if abs(corr_val) < 0.3 else "✗ High corr"
            print(f"  ES ↔ {asset}: {corr_val:>7.3f} {quality}")

    # ========================================
    # 2. WALK-FORWARD VALIDATION
    # ========================================
    print("\n" + "="*70)
    print("WALK-FORWARD VALIDATION SETUP")
    print("="*70)
    
    # Split: Train 2015-2020, Test 2020-2025
    train_end = '2020-12-31'
    test_start = '2021-01-01'
    
    train_data = price_data[price_data.index <= train_end]
    test_data = price_data[price_data.index >= test_start]
    
    train_returns = train_data.pct_change()
    test_returns = test_data.pct_change()
    
    print(f"Training period: {train_data.index[0].date()} to {train_data.index[-1].date()} ({len(train_data)} days)")
    print(f"Testing period:  {test_data.index[0].date()} to {test_data.index[-1].date()} ({len(test_data)} days)")
    
    def run_tsmom(price_df, returns_df, name="Strategy"):
        """Run TSMOM on given data"""
        
        # Multi-horizon momentum
        skip = 21
        m3  = (price_df.shift(skip) / price_df.shift(63 + skip)) - 1
        m6  = (price_df.shift(skip) / price_df.shift(126 + skip)) - 1
        m12 = (price_df.shift(skip) / price_df.shift(252 + skip)) - 1
        
        def zscore(df):
            return (df - df.mean()) / df.std()
        
        z3, z6, z12 = zscore(m3), zscore(m6), zscore(m12)
        combined_momentum = (z3 + z6 + z12) / 3
        
        # Signal
        threshold = 0.01
        raw_signal = pd.DataFrame(
            np.where(combined_momentum > threshold, 1,
                     np.where(combined_momentum < -threshold, -1, 0)),
            index=combined_momentum.index,
            columns=combined_momentum.columns
        )
        
        # Weekly rebalance
        rebalance_mask = (np.arange(len(raw_signal)) % 10 == 0)
        rebalance_mask_series = pd.Series(rebalance_mask, index=raw_signal.index)
        raw_signal = raw_signal.where(rebalance_mask_series, np.nan).ffill()
        
        # Warmup
        warmup = 252 + skip
        signal = raw_signal.iloc[warmup:].copy()
        ret_trim = returns_df.iloc[warmup:].copy()
        cm_trim = combined_momentum.loc[signal.index]
        
        # Risk-parity weighting
        raw_weights = cm_trim.clip(-2, 2)
        vol_window = 60
        asset_vol = ret_trim.rolling(vol_window).std() * np.sqrt(252)
        asset_vol = asset_vol.replace(0, np.nan).ffill().fillna(0.01)
        inv_vol = 1 / asset_vol
        
        rp_weights = raw_weights * inv_vol
        rp_weights = rp_weights.div(rp_weights.abs().sum(axis=1), axis=0).fillna(0)
        
        # Positions
        positions = np.sign(signal) * rp_weights
        
        # Returns
        strategy_ret = (positions.shift(1) * ret_trim).sum(axis=1).fillna(0)
        
        # Costs
        pos_changes = positions.diff().abs().sum(axis=1).fillna(0)
        trading_costs = pos_changes * 0.0002
        net_ret = strategy_ret - trading_costs
        
        # Vol targeting
        vol_target = 0.10
        port_vol = strategy_ret.rolling(vol_window).std() * np.sqrt(252)
        vol_scalar = (vol_target / port_vol.replace(0, np.nan)).clip(0, 3).fillna(1)
        vol_target_ret = (strategy_ret * vol_scalar.shift(1)).fillna(0)
        
        # Metrics
        def calc_metrics(r):
            r = r.dropna()
            if len(r) == 0:
                return 0.0, 0.0, 0.0
            cum = (1 + r).cumprod()
            years = len(r) / 252
            ann = cum.iloc[-1]**(1/years) - 1 if years > 0 else 0
            vol = r.std() * np.sqrt(252)
            sharpe = ann / vol if vol > 0 else 0.0
            dd = ((cum - cum.cummax()) / cum.cummax()).min()
            return ann, sharpe, dd
        
        ann, sharpe, dd = calc_metrics(net_ret)
        vol_ann, vol_sharpe, vol_dd = calc_metrics(vol_target_ret)
        
        return {
            'name': name,
            'net_ret': ann,
            'net_sharpe': sharpe,
            'net_dd': dd,
            'vol_ret': vol_ann,
            'vol_sharpe': vol_sharpe,
            'vol_dd': vol_dd,
            'turnover': pos_changes.mean() * 252,
            'prices': price_df,
            'returns': ret_trim,
            'positions': positions,
            'strategy_ret': strategy_ret,
            'net_portfolio': net_ret,
            'vol_target_ret': vol_target_ret
        }
    
    # Run on both periods
    train_results = run_tsmom(train_data, train_returns, "Training (2015-2020)")
    test_results = run_tsmom(test_data, test_returns, "Testing (2021-2025)")
    
    # ========================================
    # 3. RESULTS COMPARISON
    # ========================================
    print("\n" + "="*70)
    print("WALK-FORWARD VALIDATION RESULTS")
    print("="*70)
    print(f"{'Period':<20} {'Ann Ret':>9} {'Sharpe':>9} {'Max DD':>9} {'Turnover':>10}")
    print("-"*70)
    print(f"{'Training (2015-20)':<20} {train_results['net_ret']:>8.1%} {train_results['net_sharpe']:>9.2f} {train_results['net_dd']:>8.1%} {train_results['turnover']:>9.1f}x")
    print(f"{'Testing (2021-25)':<20} {test_results['net_ret']:>8.1%} {test_results['net_sharpe']:>9.2f} {test_results['net_dd']:>8.1%} {test_results['turnover']:>9.1f}x")
    print("-"*70)
    
    # Degradation analysis
    ret_degrade = (test_results['net_ret'] - train_results['net_ret'])
    sharpe_degrade = (test_results['net_sharpe'] - train_results['net_sharpe'])
    dd_degrade = (test_results['net_dd'] - train_results['net_dd'])
    
    print(f"\n{'Degradation:':<20} {ret_degrade:>8.1%} {sharpe_degrade:>9.2f} {dd_degrade:>8.1%}")
    
    if abs(sharpe_degrade) < 0.5:
        print("✓ ROBUST: Sharpe degradation <0.5 (good out-of-sample stability)")
    elif abs(sharpe_degrade) < 1.0:
        print("⚠️  MODERATE: Sharpe degradation 0.5-1.0 (some overfitting)")
    else:
        print("✗ OVERFIT: Sharpe degradation >1.0 (significant overfitting)")
    
    # Vol-target comparison
    print("\n" + "="*70)
    print("WITH 10% VOL TARGET")
    print("="*70)
    print(f"{'Period':<20} {'Ann Ret':>9} {'Sharpe':>9} {'Max DD':>9}")
    print("-"*70)
    print(f"{'Training (2015-20)':<20} {train_results['vol_ret']:>8.1%} {train_results['vol_sharpe']:>9.2f} {train_results['vol_dd']:>8.1%}")
    print(f"{'Testing (2021-25)':<20} {test_results['vol_ret']:>8.1%} {test_results['vol_sharpe']:>9.2f} {test_results['vol_dd']:>8.1%}")
    
    # ========================================
    # 4. STRESS PERIOD ANALYSIS
    # ========================================
    print("\n" + "="*70)
    print("STRESS PERIOD PERFORMANCE (Test Period)")
    print("="*70)
    
    stress_periods = [
        ('2021-01-01', '2021-12-31', '2021: Fed Taper Tantrum'),
        ('2022-01-01', '2022-12-31', '2022: Rate Shock'),
        ('2023-03-01', '2023-03-31', '2023: Bank Crisis'),
        ('2024-01-01', '2024-12-31', '2024: Year'),
    ]
    
    test_net = test_results['net_portfolio']
    def calc_period_metrics(ret_series, start_p, end_p):
        try:
            period_ret = ret_series[start_p:end_p]
            if len(period_ret) < 5:
                return None
            cum = (1 + period_ret).prod() - 1
            vol = period_ret.std() * np.sqrt(252)
            sharpe = (cum / (len(period_ret)/252)) / vol if vol > 0 else 0
            dd = ((period_ret.cumsum() - period_ret.cumsum().cummax()) / period_ret.cumsum().cummax()).min()
            return cum, sharpe, dd
        except:
            return None
    
    for start_p, end_p, label in stress_periods:
        metrics = calc_period_metrics(test_net, start_p, end_p)
        if metrics:
            ret, sharpe, dd = metrics
            print(f"{label:<25}: Return {ret:>8.1%}, Sharpe {sharpe:>6.2f}, Max DD {dd:>7.1%}")
    
    # ========================================
    # 5. PLOTTING
    # ========================================
    try:
        fig, axes = plt.subplots(2, 2, figsize=(16, 10))
        
        # Train vs Test cumulative
        ax1 = axes[0, 0]
        train_cum = (1 + train_results['net_portfolio']).cumprod()
        test_cum = (1 + test_results['net_portfolio']).cumprod()
        ax1.plot(train_cum.index, train_cum, label='Training (2015-20)', linewidth=2, color='blue')
        ax1.plot(test_cum.index, test_cum, label='Testing (2021-25)', linewidth=2, color='orange')
        ax1.axvline(x=pd.Timestamp('2021-01-01'), color='red', linestyle='--', alpha=0.5, label='Train/Test Split')
        ax1.set_title('Walk-Forward: Training vs Test Performance', fontsize=12, fontweight='bold')
        ax1.set_ylabel('Cumulative Return')
        ax1.legend()
        ax1.grid(True, alpha=0.3)
        
        # Correlation heatmap
        ax2 = axes[0, 1]
        im = ax2.imshow(corr_full, cmap='RdYlGn', vmin=-1, vmax=1, aspect='auto')
        ax2.set_xticks(range(len(corr_full.columns)))
        ax2.set_yticks(range(len(corr_full.columns)))
        ax2.set_xticklabels(corr_full.columns, rotation=45)
        ax2.set_yticklabels(corr_full.columns)
        for i in range(len(corr_full)):
            for j in range(len(corr_full)):
                ax2.text(j, i, f'{corr_full.iloc[i, j]:.2f}', ha='center', va='center', fontsize=8)
        ax2.set_title('Cross-Asset Correlation (Independence Check)', fontsize=12, fontweight='bold')
        plt.colorbar(im, ax=ax2)
        
        # Drawdown comparison
        ax3 = axes[1, 0]
        train_dd = (train_cum / train_cum.cummax() - 1) * 100
        test_dd = (test_cum / test_cum.cummax() - 1) * 100
        ax3.fill_between(train_dd.index, train_dd, 0, alpha=0.3, label='Training DD', color='blue')
        ax3.fill_between(test_dd.index, test_dd, 0, alpha=0.3, label='Testing DD', color='orange')
        ax3.set_title('Drawdown Comparison', fontsize=12, fontweight='bold')
        ax3.set_ylabel('Drawdown (%)')
        ax3.legend()
        ax3.grid(True, alpha=0.3)
        
        # Rolling Sharpe
        ax4 = axes[1, 1]
        roll_window = 252
        roll_sharpe_train = (train_results['strategy_ret'].rolling(roll_window).mean() * 252) / (
            train_results['strategy_ret'].rolling(roll_window).std() * np.sqrt(252)
        )
        roll_sharpe_test = (test_results['strategy_ret'].rolling(roll_window).mean() * 252) / (
            test_results['strategy_ret'].rolling(roll_window).std() * np.sqrt(252)
        )
        ax4.plot(roll_sharpe_train.index, roll_sharpe_train, label='Training', linewidth=2, color='blue')
        ax4.plot(roll_sharpe_test.index, roll_sharpe_test, label='Testing', linewidth=2, color='orange')
        ax4.axhline(y=0, color='black', linestyle='--', alpha=0.5)
        ax4.axvline(x=pd.Timestamp('2021-01-01'), color='red', linestyle='--', alpha=0.5)
        ax4.set_title('Rolling 1-Year Sharpe', fontsize=12, fontweight='bold')
        ax4.set_ylabel('Sharpe Ratio')
        ax4.legend()
        ax4.grid(True, alpha=0.3)
        
        plt.tight_layout()
        plt.savefig('tsmom_validation.png', dpi=300, bbox_inches='tight')
        print("\n" + "="*70)
        print("✓ Chart saved: tsmom_validation.png")
        print("="*70)
        plt.show()
    
    except Exception as e:
        print(f"\nPlotting error: {e}")

print("\n" + "="*70)
print("VALIDATION COMPLETE")
print("="*70)
